# Usage: cmake -DOUT=<file.cpp> "-DMODELS=<name=path|name=path>" -P embed.cmake
# Writes a C++ file that holds each weights file as a byte array.
set(code "// Generated by cmake/embed.cmake. Do not edit.\n#include <cstring>\n#include \"core/weights.h\"\nnamespace {\n")
set(lookup "")
set(i 0)
string(REPLACE "|" ";" MODELS "${MODELS}")
foreach(entry IN LISTS MODELS)
  string(REPLACE "=" ";" pair "${entry}")
  list(GET pair 0 name)
  list(GET pair 1 path)
  file(READ "${path}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND code "alignas(64) const unsigned char blob${i}[] = {${bytes}};\n")
  string(APPEND lookup "  if (model == \"${name}\") { *data = blob${i}; *size = sizeof(blob${i}); return true; }\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND code "}  // namespace\nnamespace jkp {\nbool embedded_weights(const std::string& model, const void** data, size_t* size) {\n  (void)model; (void)data; (void)size;\n${lookup}  return false;\n}\n}  // namespace jkp\n")
file(WRITE "${OUT}" "${code}")
